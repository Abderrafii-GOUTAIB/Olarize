# Local development only. Copy to .env and replace the password.
# Shared with Spring properties, shell and Compose: plain KEY=value, no quotes or export.
# Use an alphanumeric local password to avoid differences between parsers.
POSTGRES_DB=olarize
POSTGRES_USER=olarize
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5433
BACKEND_PORT=8080

# Local API runtime login; this role is created by the local Flyway setup.
LOCAL_RUNTIME_PASSWORD=replace-with-a-different-local-password

# Keycloak local-only passwords; use different alphanumeric values.
KEYCLOAK_PORT=8081
KEYCLOAK_DB_PASSWORD=replace-with-another-local-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-an-admin-password
